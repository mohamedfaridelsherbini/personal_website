        {
          "type": "text",
          "id": "QMGq7",
          "name": "Typography roles",
          "fill": "$text-secondary",
          "content": "Manrope 600: display 80/88 → 44/50 · section 40/48 → 28/36 · project 28/36 → 24/32\nIBM Plex Sans: body 16/26 · body large 20/30 → 18/28 · controls 16/24 · captions 14/20",
          "lineHeight": 1.625,
          "fontFamily": "$font-body",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "XTuKS",
          "name": "Layout and behavior",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Desktop: 1200px content, 7:5 showcases. Phone: 20px gutters, single column. Review viewports: 1440 × 1000 and 390 × 844; below-fold continuations display the complete homepage without hiding content.\nSpacing: 4 / 8 / 12 / 16 / 24 / 32 / 48 / 64 / 96. Radius: controls 8, media 16. No decorative shadows or perpetual motion.",
          "lineHeight": 1.625,
          "fontFamily": "$font-body",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "R0prlR",
          "name": "Owner decisions",
          "fill": "$brand-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "PRODUCT DECISION REQUIRED — AlaBal logo, approved story, platform/stack and real screenshots; portrait crop; Dark rollout; public languages; durable admin storage and media workflow. No invented product UI or outcomes.",
          "lineHeight": 1.625,
          "fontFamily": "$font-body",
          "fontSize": 16,
          "fontWeight": "normal"
        }
      ]
    },
